{
  "name": "bitsov-app",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:inputs": "playwright test -c playwright.inputs.config.ts",
    "test:safe-areas": "playwright test -c playwright.safe-areas.config.ts",
    "test:webkit": "playwright test -c playwright.webkit.config.ts",
    "a11y": "playwright test -c playwright.a11y.config.ts",
    "preview": "vite preview",
    "authority": "scripts/authority-check.sh",
    "check:layout": "node scripts/ui-layout/meeting-planner-check.mjs",
    "smoke:cs1": "scripts/cs1-local-smoke.sh",
    "smoke:cs2": "scripts/cs2-local-smoke.sh",
    "tauri": "tauri",
    "tauri:assistant": "BITSOV_ASSISTANT=1 tauri dev --features sit-mock",
    "tauri:dev:mainnode": "scripts/dev-node-from-main.sh",
    "tauri:dev:external": "scripts/dev-external-node.sh",
    "tauri:build:remote-test": "tauri build --debug --bundles app --config src-tauri/tauri.remote-only.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-barcode-scanner": "2.5.0",
    "@tauri-apps/plugin-notification": "2.7.0",
    "jsqr": "1.4.0",
    "solid-js": "^1.9.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "^2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.1.1"
  }
}
