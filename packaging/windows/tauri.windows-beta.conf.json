{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "tech.mindlink.bitsov.beta",
  "productName": "BitSov Beta",
  "build": {
    "beforeBundleCommand": "echo 'BitSov Beta for Windows: signet, remote node only; no node bundled'"
  },
  "app": {
    "windows": [
      {
        "title": "BitSov BETA · SIGNET · Windows preview",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
