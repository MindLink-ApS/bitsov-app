{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "CS-1: the app may run ONLY the bundled konsensus node sidecar. No general shell access; no shell API exposed to the renderer beyond this scoped sidecar. Custom commands are granted to the main window only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "bin/konsensus", "sidecar": true, "args": true }
      ]
    },
    "allow-node-status",
    "allow-fund-state",
    "allow-fund-start",
    "allow-funding-address",
    "allow-payments-balance",
    "allow-identity-restore",
    "allow-pairing-status",
    "allow-pairing-retry",
    "allow-node-overview",
    "allow-peers-list",
    "allow-rooms-list",
    "allow-room-members",
    "allow-messages-list",
    "allow-price-quote",
    "allow-payments-overview",
    "allow-spend-status",
    "allow-spend-request",
    "allow-spend-lock",
    "allow-spend-reconcile",
    "allow-message-send",
    "allow-room-quote",
    "allow-invoice-create",
    "allow-invoice-amount",
    "allow-payment-pay",
    "allow-payment-keysend",
    "allow-invite-create",
    "allow-invite-redeem",
    "allow-file-price",
    "allow-file-send",
    "allow-ai-read",
    "allow-ai-providers",
    "allow-ai-disclose",
    "allow-ai-send",
    "allow-ai-cancel"
  ]
}
