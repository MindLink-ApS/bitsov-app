{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "assistant",
  "description": "Sealed assistant window. Display only. Explicitly denies every custom command. No shell, fs, or http.",
  "windows": ["assistant"],
  "permissions": [
    "deny-node-status",
    "deny-fund-state",
    "deny-fund-start",
    "deny-funding-address",
    "deny-payments-balance",
    "deny-identity-restore"
  ]
}
