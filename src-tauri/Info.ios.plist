<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSFaceIDUsageDescription</key>
  <string>BitSov uses Face ID to approve actions with your device key.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>BitSov uses the microphone only while you record a voice note or are on a call.</string>
  <key>NSCameraUsageDescription</key>
  <string>BitSov uses the camera only during a video call you place or accept, or while you scan a pairing QR code.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>BitSov connects to your own node and to call peers on your local network.</string>
  <!-- bitsov://pair/… links (and their QR codes, via the Camera app) open the app;
       pairing_link_ios.rs queues only pairing links, for owner review. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>tech.mindlink.bitsov.pair</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>bitsov</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
