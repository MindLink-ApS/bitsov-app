<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Background audio is used only by a Live call; no VoIP push/CallKit. -->
  <key>UIBackgroundModes</key>
  <array><string>audio</string></array>
  <!-- Danish permission texts: gen/apple/bitsov-app_iOS/da.lproj/InfoPlist.strings.
       Declaring da also localizes system UI such as the paste confirmation. -->
  <key>CFBundleLocalizations</key>
  <array><string>en</string><string>da</string></array>
  <key>NSFaceIDUsageDescription</key>
  <string>BitSov uses Face ID to approve actions with your device key.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>BitSov uses the microphone only while you record a voice note or are on a call.</string>
  <key>NSCameraUsageDescription</key>
  <string>BitSov uses the camera only during a video call you place or accept, or while you scan a pairing QR code.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>BitSov needs access to your local network to connect to your box and call peers.</string>
  <!-- A received file the owner saves goes to the app's Documents folder, shown
       in the Files app under BitSov. Nothing else of the app is kept there. -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <!-- bitsov://pair/… links (and their QR codes, via the Camera app) open the app;
       pairing_link_ios.rs queues only pairing links, for owner review. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>tech.mindlink.bitsov.pair</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>bitsov</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
