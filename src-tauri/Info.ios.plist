<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Background audio is used only by a Live call; no VoIP push/CallKit. -->
  <key>UIBackgroundModes</key>
  <array><string>audio</string></array>
  <!-- Export compliance: only standard, published algorithms (TLS, Noise with
       X25519/ChaCha20-Poly1305/BLAKE2s, Ed25519, BLAKE3, P-256 via the OS), in a
       mass-market app with public source. The account owner confirms this
       answer for their own filing; see docs/IOS-TESTFLIGHT.md. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>NSFaceIDUsageDescription</key>
  <string>BitSov uses Face ID to approve actions with your device key.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>BitSov uses the microphone only while you record a voice note or are on a call.</string>
  <key>NSCameraUsageDescription</key>
  <string>BitSov uses the camera only during a video call you place or accept, or while you scan a pairing QR code.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>BitSov needs access to your local network to connect to your box and call peers.</string>
  <!-- bitsov://pair/… links (and their QR codes, via the Camera app) open the app;
       pairing_link_ios.rs queues only pairing links, for owner review. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>tech.mindlink.bitsov.pair</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>bitsov</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
