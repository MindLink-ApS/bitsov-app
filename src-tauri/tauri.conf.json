{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitSov",
  "version": "0.0.1",
  "identifier": "tech.mindlink.bitsov",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "bash scripts/fetch-node-sidecar.sh --verify-only",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BitSov",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/konsensus"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
