# Tauri's Android Studio project is source; its nested .gitignore files exclude
# Gradle, native-library, generated-config, and APK build outputs.
src-tauri/gen/*
!src-tauri/gen/android/
!src-tauri/gen/android/**
# Same for the iOS Xcode project (`tauri ios init`); its .gitignore excludes
# Externals/ (built libapp.a), build/ and xcuserdata/.
!src-tauri/gen/apple/
!src-tauri/gen/apple/**
src-tauri/permissions/autogenerated/
src-tauri/bin/konsensus-*
!src-tauri/bin/README.md

# J0 spike: model weights never enter git
*.gguf
*.safetensors
*.gguf.part
